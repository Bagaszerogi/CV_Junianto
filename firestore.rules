rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteTokenId(token) {
      return token is string && token.size() >= 6 && token.size() <= 64 && token.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidVaultKey(vaultKey) {
      return vaultKey is string && vaultKey.size() >= 24 && vaultKey.size() <= 64 && vaultKey.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidVaultAssetId(assetId) {
      return assetId is string && assetId.size() >= 27 && assetId.size() <= 196 && assetId.matches('^[a-zA-Z0-9_\\-]{24,64}__[a-zA-Z0-9_\\-]{1,128}$');
    }

    function isValidEmailStr(val) {
      return val is string && val.size() >= 3 && val.size() <= 140 && val.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isValidAdminKey(id) {
      return id is string && id.size() >= 1 && id.size() <= 140 && (
        id.matches('^[a-zA-Z0-9_\\-]+$') ||
        (isValidEmailStr(id) && id == id.lower())
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return request.auth.token.email_verified == true && request.auth.token.email is string;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          isVerifiedEmail() && (
            request.auth.token.email.lower() in ['it@hotelciputra.com', 'bagaszerogi@gmail.com', 'zerogi26@gmail.com'] ||
            exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
          )
        )
      );
    }

    function isValidPortrait(val) {
      return val is string && val.size() >= 5 && val.size() <= 600000 && !val.matches('.*\\.\\..*') && (
        val.matches('^/assets/[a-zA-Z0-9_./-]+$') ||
        val.matches('^data:image\\/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
      );
    }

    function isValidMetric(m) {
      return m is map &&
        m.keys().hasAll(['value', 'valueId', 'label', 'labelId', 'detail', 'detailId']) &&
        m.keys().hasOnly(['value', 'valueId', 'label', 'labelId', 'detail', 'detailId']) &&
        m.value is string && m.value.size() >= 1 && m.value.size() <= 40 &&
        m.valueId is string && m.valueId.size() >= 1 && m.valueId.size() <= 40 &&
        m.label is string && m.label.size() >= 1 && m.label.size() <= 80 &&
        m.labelId is string && m.labelId.size() >= 1 && m.labelId.size() <= 80 &&
        m.detail is string && m.detail.size() <= 120 &&
        m.detailId is string && m.detailId.size() <= 120;
    }

    function isValidEducation(edu) {
      return edu is map &&
        edu.keys().hasAll(['institution', 'majorEn', 'majorId', 'period', 'gpaEn', 'gpaId', 'focusEn', 'focusId']) &&
        edu.keys().hasOnly(['institution', 'majorEn', 'majorId', 'period', 'gpaEn', 'gpaId', 'focusEn', 'focusId']) &&
        edu.institution is string && edu.institution.size() >= 1 && edu.institution.size() <= 160 &&
        edu.majorEn is string && edu.majorEn.size() >= 1 && edu.majorEn.size() <= 140 &&
        edu.majorId is string && edu.majorId.size() >= 1 && edu.majorId.size() <= 140 &&
        edu.period is string && edu.period.size() >= 1 && edu.period.size() <= 40 &&
        edu.gpaEn is string && edu.gpaEn.size() >= 1 && edu.gpaEn.size() <= 40 &&
        edu.gpaId is string && edu.gpaId.size() >= 1 && edu.gpaId.size() <= 40 &&
        edu.focusEn is string && edu.focusEn.size() <= 600 &&
        edu.focusId is string && edu.focusId.size() <= 600;
    }

    function isValidProfile(data) {
      return data.keys().hasAll([
          'name',
          'brandShort',
          'titleEn',
          'titleId',
          'kickerEn',
          'kickerId',
          'currentCompany',
          'currentRole',
          'summaryEn',
          'summaryId',
          'phoneDisplay',
          'whatsappHref',
          'email',
          'address',
          'portraitDataUrl',
          'metrics',
          'education',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name',
          'brandShort',
          'titleEn',
          'titleId',
          'kickerEn',
          'kickerId',
          'currentCompany',
          'currentRole',
          'summaryEn',
          'summaryId',
          'phoneDisplay',
          'whatsappHref',
          'email',
          'address',
          'portraitDataUrl',
          'metrics',
          'education',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.brandShort is string && data.brandShort.size() >= 1 && data.brandShort.size() <= 60 &&
        data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 140 &&
        data.titleId is string && data.titleId.size() >= 1 && data.titleId.size() <= 140 &&
        data.kickerEn is string && data.kickerEn.size() <= 160 &&
        data.kickerId is string && data.kickerId.size() <= 160 &&
        data.currentCompany is string && data.currentCompany.size() >= 1 && data.currentCompany.size() <= 140 &&
        data.currentRole is string && data.currentRole.size() >= 1 && data.currentRole.size() <= 140 &&
        data.summaryEn is string && data.summaryEn.size() >= 1 && data.summaryEn.size() <= 1500 &&
        data.summaryId is string && data.summaryId.size() >= 1 && data.summaryId.size() <= 1500 &&
        data.phoneDisplay is string && data.phoneDisplay.size() >= 1 && data.phoneDisplay.size() <= 40 &&
        data.whatsappHref is string && data.whatsappHref.size() >= 1 && data.whatsappHref.size() <= 200 &&
        data.whatsappHref.matches('^https://wa\\.me/[0-9]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 140 &&
        data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 240 &&
        isValidPortrait(data.portraitDataUrl) &&
        data.metrics is list && data.metrics.size() >= 1 && data.metrics.size() <= 6 &&
        isValidMetric(data.metrics[0]) &&
        (data.metrics.size() < 2 || isValidMetric(data.metrics[1])) &&
        (data.metrics.size() < 3 || isValidMetric(data.metrics[2])) &&
        (data.metrics.size() < 4 || isValidMetric(data.metrics[3])) &&
        (data.metrics.size() < 5 || isValidMetric(data.metrics[4])) &&
        (data.metrics.size() < 6 || isValidMetric(data.metrics[5])) &&
        isValidEducation(data.education) &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll([
          'title',
          'property',
          'year',
          'category',
          'description',
          'imageDataUrl',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title',
          'property',
          'year',
          'category',
          'description',
          'imageDataUrl',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.property is string && data.property.size() <= 140 &&
        data.year is string && data.year.size() >= 1 && data.year.size() <= 24 && data.year.matches('^[0-9A-Za-z\\s\\-]+$') &&
        data.category is string && data.category in ['infrastructure', 'pms-pos', 'security', 'event-av'] &&
        data.description is string && data.description.size() <= 1200 &&
        data.imageDataUrl is string && data.imageDataUrl.size() >= 24 && data.imageDataUrl.size() <= 750000 &&
        data.imageDataUrl.matches('^data:image\\/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$') &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLocaleCopy(c) {
      return c is map &&
        c.keys().hasAll([
          'navProfile', 'navExperience', 'navProjects', 'navStack', 'navContact',
          'downloadPdf', 'heroActiveBadge', 'heroPropertyScale', 'heroDossierFooter', 'heroSendEmail',
          'experienceKicker', 'experienceTitle', 'experienceDesc',
          'projectsKicker', 'projectsTitle', 'projectsDesc',
          'stackKicker', 'stackTitle', 'stackDesc',
          'educationKicker', 'educationTitle',
          'referencesKicker', 'referencesTitle', 'referencesNote',
          'contactKicker', 'contactTitle', 'contactDesc',
          'composerTitle', 'composerDesc', 'footerNote'
        ]) &&
        c.keys().hasOnly([
          'navProfile', 'navExperience', 'navProjects', 'navStack', 'navContact',
          'downloadPdf', 'heroActiveBadge', 'heroPropertyScale', 'heroDossierFooter', 'heroSendEmail',
          'experienceKicker', 'experienceTitle', 'experienceDesc',
          'projectsKicker', 'projectsTitle', 'projectsDesc',
          'stackKicker', 'stackTitle', 'stackDesc',
          'educationKicker', 'educationTitle',
          'referencesKicker', 'referencesTitle', 'referencesNote',
          'contactKicker', 'contactTitle', 'contactDesc',
          'composerTitle', 'composerDesc', 'footerNote'
        ]) &&
        c.navProfile is string && c.navProfile.size() >= 1 && c.navProfile.size() <= 40 &&
        c.navExperience is string && c.navExperience.size() >= 1 && c.navExperience.size() <= 40 &&
        c.navProjects is string && c.navProjects.size() >= 1 && c.navProjects.size() <= 40 &&
        c.navStack is string && c.navStack.size() >= 1 && c.navStack.size() <= 40 &&
        c.navContact is string && c.navContact.size() >= 1 && c.navContact.size() <= 40 &&
        c.downloadPdf is string && c.downloadPdf.size() >= 1 && c.downloadPdf.size() <= 80 &&
        c.heroActiveBadge is string && c.heroActiveBadge.size() >= 1 && c.heroActiveBadge.size() <= 60 &&
        c.heroPropertyScale is string && c.heroPropertyScale.size() >= 1 && c.heroPropertyScale.size() <= 140 &&
        c.heroDossierFooter is string && c.heroDossierFooter.size() >= 1 && c.heroDossierFooter.size() <= 100 &&
        c.heroSendEmail is string && c.heroSendEmail.size() >= 1 && c.heroSendEmail.size() <= 50 &&
        c.experienceKicker is string && c.experienceKicker.size() >= 1 && c.experienceKicker.size() <= 80 &&
        c.experienceTitle is string && c.experienceTitle.size() >= 1 && c.experienceTitle.size() <= 120 &&
        c.experienceDesc is string && c.experienceDesc.size() >= 1 && c.experienceDesc.size() <= 400 &&
        c.projectsKicker is string && c.projectsKicker.size() >= 1 && c.projectsKicker.size() <= 80 &&
        c.projectsTitle is string && c.projectsTitle.size() >= 1 && c.projectsTitle.size() <= 120 &&
        c.projectsDesc is string && c.projectsDesc.size() >= 1 && c.projectsDesc.size() <= 400 &&
        c.stackKicker is string && c.stackKicker.size() >= 1 && c.stackKicker.size() <= 80 &&
        c.stackTitle is string && c.stackTitle.size() >= 1 && c.stackTitle.size() <= 120 &&
        c.stackDesc is string && c.stackDesc.size() >= 1 && c.stackDesc.size() <= 400 &&
        c.educationKicker is string && c.educationKicker.size() >= 1 && c.educationKicker.size() <= 80 &&
        c.educationTitle is string && c.educationTitle.size() >= 1 && c.educationTitle.size() <= 120 &&
        c.referencesKicker is string && c.referencesKicker.size() >= 1 && c.referencesKicker.size() <= 80 &&
        c.referencesTitle is string && c.referencesTitle.size() >= 1 && c.referencesTitle.size() <= 120 &&
        c.referencesNote is string && c.referencesNote.size() >= 1 && c.referencesNote.size() <= 300 &&
        c.contactKicker is string && c.contactKicker.size() >= 1 && c.contactKicker.size() <= 80 &&
        c.contactTitle is string && c.contactTitle.size() >= 1 && c.contactTitle.size() <= 120 &&
        c.contactDesc is string && c.contactDesc.size() >= 1 && c.contactDesc.size() <= 400 &&
        c.composerTitle is string && c.composerTitle.size() >= 1 && c.composerTitle.size() <= 120 &&
        c.composerDesc is string && c.composerDesc.size() >= 1 && c.composerDesc.size() <= 300 &&
        c.footerNote is string && c.footerNote.size() >= 1 && c.footerNote.size() <= 240;
    }

    function isValidSiteContent(data) {
      return data.keys().hasAll(['en', 'id', 'authorId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['en', 'id', 'authorId', 'createdAt', 'updatedAt']) &&
        isValidLocaleCopy(data.en) &&
        isValidLocaleCopy(data.id) &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminId) {
      return data.keys().hasAll(['email', 'role', 'provider', 'updatedAt']) &&
        data.keys().hasOnly(['email', 'role', 'provider', 'addedBy', 'updatedAt']) &&
        isValidEmailStr(data.email) &&
        data.role is string && data.role == 'admin' &&
        data.provider is string && data.provider.size() >= 1 && data.provider.size() <= 40 &&
        (!('addedBy' in data) || (data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128)) &&
        data.updatedAt is timestamp &&
        (
          (isVerifiedEmail() && adminId == request.auth.uid && data.email.lower() == request.auth.token.email.lower()) ||
          (isValidEmailStr(adminId) && adminId == adminId.lower() && data.email.lower() == adminId) ||
          (isValidId(adminId) && 'addedBy' in data)
        );
    }

    function isValidAdminsRegistry(data) {
      return data.keys().hasAll(['emails', 'authorId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['emails', 'authorId', 'createdAt', 'updatedAt']) &&
        data.emails is list && data.emails.size() <= 50 &&
        (data.emails.size() == 0 || isValidEmailStr(data.emails[0])) &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCvIndex(data) {
      return data.keys().hasAll([
          'vaultKey', 'experienceIds', 'projectIds', 'techStackIds',
          'referenceIds', 'inviteTokens', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'vaultKey', 'experienceIds', 'projectIds', 'techStackIds',
          'referenceIds', 'inviteTokens', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        isValidVaultKey(data.vaultKey) &&
        data.experienceIds is list && data.experienceIds.size() <= 60 &&
        data.projectIds is list && data.projectIds.size() <= 60 &&
        data.techStackIds is list && data.techStackIds.size() <= 60 &&
        data.referenceIds is list && data.referenceIds.size() <= 60 &&
        data.inviteTokens is list && data.inviteTokens.size() <= 100 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInviteTokenDoc(data) {
      return data.keys().hasAll([
          'label', 'active', 'expiresAt', 'vaultKey', 'createdByEmail',
          'authorId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'label', 'active', 'expiresAt', 'vaultKey', 'createdByEmail',
          'authorId', 'createdAt', 'updatedAt'
        ]) &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
        data.active is bool &&
        (data.expiresAt == null || data.expiresAt is timestamp) &&
        isValidVaultKey(data.vaultKey) &&
        isValidEmailStr(data.createdByEmail) &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCvShareBundle(data) {
      return data.keys().hasAll([
          'profile', 'siteContent', 'experiences', 'techStacks',
          'references', 'projectMeta', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'profile', 'siteContent', 'experiences', 'techStacks',
          'references', 'projectMeta', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        data.profile is map &&
        data.siteContent is map &&
        data.experiences is list && data.experiences.size() <= 60 &&
        data.techStacks is list && data.techStacks.size() <= 60 &&
        data.references is list && data.references.size() <= 60 &&
        data.projectMeta is list && data.projectMeta.size() <= 60 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCvProjectAsset(data) {
      return data.keys().hasAll(['projectId', 'imageDataUrl', 'authorId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['projectId', 'imageDataUrl', 'authorId', 'createdAt', 'updatedAt']) &&
        isValidId(data.projectId) &&
        data.imageDataUrl is string && data.imageDataUrl.size() >= 24 && data.imageDataUrl.size() <= 750000 &&
        data.imageDataUrl.matches('^data:image\\/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$') &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function preservesImmutableAuditFields() {
      return (
        (!('authorId' in existing()) ? incoming().authorId == request.auth.uid : incoming().authorId == existing().authorId) &&
        (!('createdAt' in existing()) ? incoming().createdAt == request.time : incoming().createdAt == existing().createdAt)
      );
    }

    function isValidCareerStage(s) {
      return s is map &&
        s.keys().hasAll(['id', 'role', 'roleId', 'status', 'period', 'periodId', 'bullets', 'bulletsId']) &&
        s.keys().hasOnly(['id', 'role', 'roleId', 'status', 'employmentType', 'period', 'periodId', 'bullets', 'bulletsId']) &&
        isValidId(s.id) &&
        s.role is string && s.role.size() >= 1 && s.role.size() <= 140 &&
        s.roleId is string && s.roleId.size() >= 1 && s.roleId.size() <= 140 &&
        s.status is string && s.status in ['active', 'completed'] &&
        (!('employmentType' in s) || (s.employmentType is string && s.employmentType in ['full-time', 'promotion', 'contract', 'consulting'])) &&
        s.period is string && s.period.size() >= 1 && s.period.size() <= 60 &&
        s.periodId is string && s.periodId.size() >= 1 && s.periodId.size() <= 60 &&
        s.bullets is list && s.bullets.size() >= 1 && s.bullets.size() <= 15 && s.bullets[0] is string && s.bullets[0].size() >= 1 && s.bullets[0].size() <= 500 &&
        s.bulletsId is list && s.bulletsId.size() >= 1 && s.bulletsId.size() <= 15 && s.bulletsId[0] is string && s.bulletsId[0].size() >= 1 && s.bulletsId[0].size() <= 500;
    }

    function isValidExperience(data) {
      return data.keys().hasAll([
          'company',
          'role',
          'roleId',
          'status',
          'category',
          'period',
          'periodId',
          'scaleContext',
          'scaleContextId',
          'bullets',
          'bulletsId',
          'systems',
          'sortOrder',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'company',
          'role',
          'roleId',
          'status',
          'category',
          'period',
          'periodId',
          'scaleContext',
          'scaleContextId',
          'bullets',
          'bulletsId',
          'systems',
          'sortOrder',
          'careerStages',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.company is string && data.company.size() >= 1 && data.company.size() <= 140 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 140 &&
        data.roleId is string && data.roleId.size() >= 1 && data.roleId.size() <= 140 &&
        data.status is string && data.status in ['active', 'completed'] &&
        data.category is string && data.category in ['leadership', 'operations'] &&
        data.period is string && data.period.size() >= 1 && data.period.size() <= 60 &&
        data.periodId is string && data.periodId.size() >= 1 && data.periodId.size() <= 60 &&
        data.scaleContext is string && data.scaleContext.size() <= 200 &&
        data.scaleContextId is string && data.scaleContextId.size() <= 200 &&
        data.bullets is list && data.bullets.size() >= 1 && data.bullets.size() <= 15 && data.bullets[0] is string && data.bullets[0].size() >= 1 && data.bullets[0].size() <= 500 &&
        data.bulletsId is list && data.bulletsId.size() >= 1 && data.bulletsId.size() <= 15 && data.bulletsId[0] is string && data.bulletsId[0].size() >= 1 && data.bulletsId[0].size() <= 500 &&
        data.systems is list && data.systems.size() <= 25 && (data.systems.size() == 0 || (data.systems[0] is string && data.systems[0].size() >= 1 && data.systems[0].size() <= 80)) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        (!('careerStages' in data) || (
          data.careerStages is list &&
          data.careerStages.size() >= 1 &&
          data.careerStages.size() <= 8 &&
          isValidCareerStage(data.careerStages[0]) &&
          (data.careerStages.size() < 2 || isValidCareerStage(data.careerStages[1])) &&
          (data.careerStages.size() < 3 || isValidCareerStage(data.careerStages[2])) &&
          (data.careerStages.size() < 4 || isValidCareerStage(data.careerStages[3])) &&
          (data.careerStages.size() < 5 || isValidCareerStage(data.careerStages[4])) &&
          (data.careerStages.size() < 6 || isValidCareerStage(data.careerStages[5])) &&
          (data.careerStages.size() < 7 || isValidCareerStage(data.careerStages[6])) &&
          (data.careerStages.size() < 8 || isValidCareerStage(data.careerStages[7]))
        )) &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTechStack(data) {
      return data.keys().hasAll(['group', 'label', 'labelId', 'items', 'sortOrder', 'authorId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['group', 'label', 'labelId', 'items', 'sortOrder', 'authorId', 'createdAt', 'updatedAt']) &&
        data.group is string && data.group in ['core', 'infra', 'guest', 'productivity'] &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 100 &&
        data.labelId is string && data.labelId.size() >= 1 && data.labelId.size() <= 100 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 40 && data.items[0] is string && data.items[0].size() >= 1 && data.items[0].size() <= 100 &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReference(data) {
      return data.keys().hasAll(['name', 'role', 'phone', 'sortOrder', 'authorId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'role', 'phone', 'sortOrder', 'authorId', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 140 &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 40 &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Private Admin-Only Master CV Profile & Education
    match /profile/{profileId} {
      allow get: if isAdmin() && isValidId(profileId);
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(profileId) &&
        isValidProfile(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(profileId) &&
        isValidProfile(incoming()) &&
        preservesImmutableAuditFields() &&
        incoming().updatedAt == request.time &&
        (!('authorId' in existing()) || incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'brandShort',
          'titleEn',
          'titleId',
          'kickerEn',
          'kickerId',
          'currentCompany',
          'currentRole',
          'summaryEn',
          'summaryId',
          'phoneDisplay',
          'whatsappHref',
          'email',
          'address',
          'portraitDataUrl',
          'metrics',
          'education',
          'updatedAt'
        ]));

      allow delete: if false;
    }

    // Private Admin-Only Master CV Project Gallery
    match /projects/{projectId} {
      allow get: if isAdmin() && isValidId(projectId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(projectId) &&
        isValidProject(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(projectId) &&
        isValidProject(incoming()) &&
        preservesImmutableAuditFields() &&
        incoming().updatedAt == request.time &&
        (!('authorId' in existing()) || incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'property',
          'year',
          'category',
          'description',
          'imageDataUrl',
          'updatedAt'
        ]));

      allow delete: if isAdmin() && isValidId(projectId);
    }

    // Private Admin-Only Master CV Work Experience Timeline
    match /experiences/{experienceId} {
      allow get: if isAdmin() && isValidId(experienceId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(experienceId) &&
        isValidExperience(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(experienceId) &&
        isValidExperience(incoming()) &&
        preservesImmutableAuditFields() &&
        incoming().updatedAt == request.time &&
        (!('authorId' in existing()) || incoming().diff(existing()).affectedKeys().hasOnly([
          'company',
          'role',
          'roleId',
          'status',
          'category',
          'period',
          'periodId',
          'scaleContext',
          'scaleContextId',
          'bullets',
          'bulletsId',
          'systems',
          'sortOrder',
          'careerStages',
          'updatedAt'
        ]));

      allow delete: if isAdmin() && isValidId(experienceId);
    }

    // Private Admin-Only Master CV Tech Stack Expertise
    match /techStacks/{stackId} {
      allow get: if isAdmin() && isValidId(stackId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(stackId) &&
        isValidTechStack(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(stackId) &&
        isValidTechStack(incoming()) &&
        preservesImmutableAuditFields() &&
        incoming().updatedAt == request.time &&
        (!('authorId' in existing()) || incoming().diff(existing()).affectedKeys().hasOnly([
          'group',
          'label',
          'labelId',
          'items',
          'sortOrder',
          'updatedAt'
        ]));

      allow delete: if isAdmin() && isValidId(stackId);
    }

    // Private Admin-Only Master CV Professional References
    match /references/{refId} {
      allow get: if isAdmin() && isValidId(refId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(refId) &&
        isValidReference(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(refId) &&
        isValidReference(incoming()) &&
        preservesImmutableAuditFields() &&
        incoming().updatedAt == request.time &&
        (!('authorId' in existing()) || incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'role',
          'phone',
          'sortOrder',
          'updatedAt'
        ]));

      allow delete: if isAdmin() && isValidId(refId);
    }

    // Private Admin-Only Master CV Site Copy
    match /siteContent/{contentId} {
      allow get: if isAdmin() && isValidId(contentId);
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(contentId) &&
        isValidSiteContent(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(contentId) &&
        isValidSiteContent(incoming()) &&
        preservesImmutableAuditFields() &&
        incoming().updatedAt == request.time &&
        (!('authorId' in existing()) || incoming().diff(existing()).affectedKeys().hasOnly(['en', 'id', 'updatedAt']));

      allow delete: if false;
    }

    // Admin Index tracking CV document IDs, active invite tokens, and sharing vaultKey
    match /cvIndex/{indexId} {
      allow get: if isAdmin() && isValidId(indexId);
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(indexId) &&
        isValidCvIndex(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(indexId) &&
        isValidCvIndex(incoming()) &&
        preservesImmutableAuditFields() &&
        incoming().updatedAt == request.time &&
        (!('authorId' in existing()) || incoming().diff(existing()).affectedKeys().hasOnly([
          'vaultKey',
          'experienceIds',
          'projectIds',
          'techStackIds',
          'referenceIds',
          'inviteTokens',
          'updatedAt'
        ]));

      allow delete: if false;
    }

    // Invite Links (non-listable; readable via single-doc get ONLY if active and unexpired)
    match /invites/{token} {
      allow get: if isAdmin() || (
        isValidInviteTokenId(token) &&
        existing().active == true &&
        (existing().expiresAt == null || existing().expiresAt > request.time)
      );
      allow list: if false;

      allow create: if isAdmin() &&
        isValidInviteTokenId(token) &&
        isValidInviteTokenDoc(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidInviteTokenId(token) &&
        isValidInviteTokenDoc(incoming()) &&
        preservesImmutableAuditFields() &&
        incoming().updatedAt == request.time &&
        (!('authorId' in existing()) || incoming().diff(existing()).affectedKeys().hasOnly([
          'label',
          'active',
          'expiresAt',
          'vaultKey',
          'updatedAt'
        ]));

      allow delete: if isAdmin() && isValidInviteTokenId(token);
    }

    // Published CV Share Snapshots (non-listable; keyed by unguessable vaultKey)
    match /cvShares/{vaultKey} {
      allow get: if isAdmin() || isValidVaultKey(vaultKey);
      allow list: if false;

      allow create: if isAdmin() &&
        isValidVaultKey(vaultKey) &&
        isValidCvShareBundle(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidVaultKey(vaultKey) &&
        isValidCvShareBundle(incoming()) &&
        preservesImmutableAuditFields() &&
        incoming().updatedAt == request.time &&
        (!('authorId' in existing()) || incoming().diff(existing()).affectedKeys().hasOnly([
          'profile',
          'siteContent',
          'experiences',
          'techStacks',
          'references',
          'projectMeta',
          'updatedAt'
        ]));

      allow delete: if isAdmin() && isValidVaultKey(vaultKey);
    }

    // Published Project Images (non-listable; keyed by vaultKey__projectId)
    match /cvProjectAssets/{assetId} {
      allow get: if isAdmin() || isValidVaultAssetId(assetId);
      allow list: if false;

      allow create: if isAdmin() &&
        isValidVaultAssetId(assetId) &&
        isValidCvProjectAsset(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidVaultAssetId(assetId) &&
        isValidCvProjectAsset(incoming()) &&
        preservesImmutableAuditFields() &&
        incoming().updatedAt == request.time &&
        (!('authorId' in existing()) || incoming().diff(existing()).affectedKeys().hasOnly([
          'projectId',
          'imageDataUrl',
          'updatedAt'
        ]));

      allow delete: if isAdmin() && isValidVaultAssetId(assetId);
    }

    // Admin UID & Email Registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidAdminKey(adminId) && (
        request.auth.uid == adminId ||
        (isVerifiedEmail() && request.auth.token.email.lower() == adminId) ||
        isAdmin()
      );
      allow list: if false;
      allow create, update: if isSignedIn() &&
        isValidAdminKey(adminId) &&
        isValidAdminRecord(incoming(), adminId) &&
        incoming().updatedAt == request.time &&
        (
          (
            isVerifiedEmail() &&
            request.auth.uid == adminId &&
            (
              request.auth.token.email.lower() in ['it@hotelciputra.com', 'bagaszerogi@gmail.com', 'zerogi26@gmail.com'] ||
              exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
            )
          ) ||
          (
            isAdmin() &&
            (
              (isValidEmailStr(adminId) && adminId == adminId.lower()) ||
              isValidId(adminId)
            )
          )
        );
      allow delete: if isAdmin() && isValidAdminKey(adminId);
    }

    // Private Admin Email Directory
    match /adminsRegistry/{registryId} {
      allow get: if isAdmin() && isValidId(registryId);
      allow list: if false;
      allow create: if isAdmin() &&
        isValidId(registryId) &&
        isValidAdminsRegistry(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(registryId) &&
        isValidAdminsRegistry(incoming()) &&
        preservesImmutableAuditFields() &&
        incoming().updatedAt == request.time &&
        (!('authorId' in existing()) || incoming().diff(existing()).affectedKeys().hasOnly(['emails', 'updatedAt']));
      allow delete: if false;
    }
  }
}
