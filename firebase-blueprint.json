{
  "entities": {
    "CvProfile": {
      "title": "CvProfile",
      "description": "Primary CV identity, portrait photo, contact details, metrics strip, and education record (admin-private master).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "brandShort": { "type": "string", "minLength": 1, "maxLength": 60 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 140 },
        "titleId": { "type": "string", "minLength": 1, "maxLength": 140 },
        "kickerEn": { "type": "string", "minLength": 0, "maxLength": 160 },
        "kickerId": { "type": "string", "minLength": 0, "maxLength": 160 },
        "currentCompany": { "type": "string", "minLength": 1, "maxLength": 140 },
        "currentRole": { "type": "string", "minLength": 1, "maxLength": 140 },
        "summaryEn": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "summaryId": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "phoneDisplay": { "type": "string", "minLength": 1, "maxLength": 40 },
        "whatsappHref": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^https://wa\\.me/[0-9]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 140, "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$" },
        "address": { "type": "string", "minLength": 1, "maxLength": 240 },
        "portraitDataUrl": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600000,
          "pattern": "^(/assets/[a-zA-Z0-9_./-]+|data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+)$"
        },
        "metrics": { "type": "array" },
        "education": { "type": "object" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "brandShort",
        "titleEn",
        "titleId",
        "kickerEn",
        "kickerId",
        "currentCompany",
        "currentRole",
        "summaryEn",
        "summaryId",
        "phoneDisplay",
        "whatsappHref",
        "email",
        "address",
        "portraitDataUrl",
        "metrics",
        "education",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Project": {
      "title": "Project",
      "description": "A hospitality IT project photo and summary managed by verified admins.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "property": { "type": "string", "minLength": 0, "maxLength": 140 },
        "year": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[0-9A-Za-z\\s\\-]+$" },
        "category": { "type": "string", "enum": ["infrastructure", "pms-pos", "security", "event-av"] },
        "description": { "type": "string", "minLength": 0, "maxLength": 1200 },
        "imageDataUrl": {
          "type": "string",
          "minLength": 24,
          "maxLength": 750000,
          "pattern": "^data:image\\/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$"
        },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "property",
        "year",
        "category",
        "description",
        "imageDataUrl",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Experience": {
      "title": "Experience",
      "description": "A work experience entry managed by verified admins.",
      "type": "object",
      "properties": {
        "company": { "type": "string", "minLength": 1, "maxLength": 140 },
        "role": { "type": "string", "minLength": 1, "maxLength": 140 },
        "roleId": { "type": "string", "minLength": 1, "maxLength": 140 },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "category": { "type": "string", "enum": ["leadership", "operations"] },
        "period": { "type": "string", "minLength": 1, "maxLength": 60 },
        "periodId": { "type": "string", "minLength": 1, "maxLength": 60 },
        "scaleContext": { "type": "string", "minLength": 0, "maxLength": 200 },
        "scaleContextId": { "type": "string", "minLength": 0, "maxLength": 200 },
        "bullets": { "type": "array" },
        "bulletsId": { "type": "array" },
        "systems": { "type": "array" },
        "sortOrder": { "type": "number" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "company",
        "role",
        "roleId",
        "status",
        "category",
        "period",
        "periodId",
        "scaleContext",
        "scaleContextId",
        "bullets",
        "bulletsId",
        "systems",
        "sortOrder",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "TechStackItem": {
      "title": "TechStackItem",
      "description": "Technology stack expertise category and tool list.",
      "type": "object",
      "properties": {
        "group": { "type": "string", "enum": ["core", "infra", "guest", "productivity"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "labelId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "items": { "type": "array" },
        "sortOrder": { "type": "number" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["group", "label", "labelId", "items", "sortOrder", "authorId", "createdAt", "updatedAt"]
    },
    "ReferencePerson": {
      "title": "ReferencePerson",
      "description": "Professional reference contact managed by verified admins.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "minLength": 1, "maxLength": 140 },
        "phone": { "type": "string", "minLength": 1, "maxLength": 40 },
        "sortOrder": { "type": "number" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "phone", "sortOrder", "authorId", "createdAt", "updatedAt"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Bilingual editable CV UI headings, kickers, descriptions, navigation labels, and footer copy.",
      "type": "object",
      "properties": {
        "en": { "type": "object" },
        "id": { "type": "object" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["en", "id", "authorId", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin UID or lowercase email registry document.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 140 },
        "role": { "type": "string", "enum": ["admin"] },
        "provider": { "type": "string", "minLength": 1, "maxLength": 40 },
        "addedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "provider", "updatedAt"]
    },
    "AdminsRegistry": {
      "title": "AdminsRegistry",
      "description": "Private directory of Firestore-registered admin email addresses.",
      "type": "object",
      "properties": {
        "emails": { "type": "array" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["emails", "authorId", "createdAt", "updatedAt"]
    },
    "CvIndex": {
      "title": "CvIndex",
      "description": "Admin index of CV document IDs and active vaultKey used for direct document reads and snapshot syncing.",
      "type": "object",
      "properties": {
        "vaultKey": { "type": "string", "minLength": 24, "maxLength": 64 },
        "experienceIds": { "type": "array" },
        "projectIds": { "type": "array" },
        "techStackIds": { "type": "array" },
        "referenceIds": { "type": "array" },
        "inviteTokens": { "type": "array" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "vaultKey",
        "experienceIds",
        "projectIds",
        "techStackIds",
        "referenceIds",
        "inviteTokens",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "InviteToken": {
      "title": "InviteToken",
      "description": "Recruiter/HRD private invitation token document granting access only when active and unexpired.",
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "active": { "type": "boolean" },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "vaultKey": { "type": "string", "minLength": 24, "maxLength": 64 },
        "createdByEmail": { "type": "string", "minLength": 3, "maxLength": 140 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "label",
        "active",
        "expiresAt",
        "vaultKey",
        "createdByEmail",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "CvShareBundle": {
      "title": "CvShareBundle",
      "description": "Published CV payload keyed by an unguessable vaultKey only readable by holders of an active invite token.",
      "type": "object",
      "properties": {
        "profile": { "type": "object" },
        "siteContent": { "type": "object" },
        "experiences": { "type": "array" },
        "techStacks": { "type": "array" },
        "references": { "type": "array" },
        "projectMeta": { "type": "array" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "profile",
        "siteContent",
        "experiences",
        "techStacks",
        "references",
        "projectMeta",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "CvProjectAsset": {
      "title": "CvProjectAsset",
      "description": "Published project image asset keyed by vaultKey__projectId for invited CV viewing.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "imageDataUrl": {
          "type": "string",
          "minLength": 24,
          "maxLength": 750000,
          "pattern": "^data:image\\/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$"
        },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "imageDataUrl", "authorId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/profile/{profileId}": {
      "schema": { "$ref": "#/entities/CvProfile" },
      "description": "Private admin-only master CV profile, portrait photo, contact details, metrics, and education."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Private admin-only master hospitality IT project gallery."
    },
    "/experiences/{experienceId}": {
      "schema": { "$ref": "#/entities/Experience" },
      "description": "Private admin-only master work experience timeline."
    },
    "/techStacks/{stackId}": {
      "schema": { "$ref": "#/entities/TechStackItem" },
      "description": "Private admin-only master technology stack categories."
    },
    "/references/{refId}": {
      "schema": { "$ref": "#/entities/ReferencePerson" },
      "description": "Private admin-only master professional references."
    },
    "/siteContent/{contentId}": {
      "schema": { "$ref": "#/entities/SiteContent" },
      "description": "Private admin-only master bilingual CV labels and descriptive text."
    },
    "/cvIndex/{indexId}": {
      "schema": { "$ref": "#/entities/CvIndex" },
      "description": "Admin-only index tracking CV document IDs, invite tokens, and the active sharing vaultKey."
    },
    "/invites/{token}": {
      "schema": { "$ref": "#/entities/InviteToken" },
      "description": "Non-listable invitation tokens verifiable by single-document get only when active and unexpired."
    },
    "/cvShares/{vaultKey}": {
      "schema": { "$ref": "#/entities/CvShareBundle" },
      "description": "Non-listable published CV snapshot keyed by an unguessable vaultKey."
    },
    "/cvProjectAssets/{assetId}": {
      "schema": { "$ref": "#/entities/CvProjectAsset" },
      "description": "Non-listable published project images keyed by vaultKey__projectId."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin UID or lowercase email registry readable by the matching user or verified admins."
    },
    "/adminsRegistry/{registryId}": {
      "schema": { "$ref": "#/entities/AdminsRegistry" },
      "description": "Private admin directory listing emails granted edit permissions."
    }
  }
}
